# Copy this file to .env and fill in real values before deploying:
#   cp .env.example .env
#
# Generate a password hash by running (after `npm install`):
#   node hash-password.js "yourpassword"
# Then paste the printed hash below.
APP_PASSWORD_HASH=

# Any long random string works. You can generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-long-string

PORT=3000
